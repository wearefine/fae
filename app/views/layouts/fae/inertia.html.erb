<!DOCTYPE html>
<%
  fae_option = @option || Fae::Option.instance
  fae_default_highlight = fae_option.colorway.to_s.sub(/^#/, '')
  fae_default_highlight = '9aa142' if fae_default_highlight.blank?
  fae_default_highlight = "##{fae_default_highlight}"

  if current_user&.respond_to?(:theme_mode)
    fae_theme_mode = current_user.theme_mode
    fae_highlight = current_user.theme_highlight_color(fae_default_highlight)
  else
    fae_theme_mode = 'light'
    fae_highlight = fae_default_highlight
  end
%>
<html data-fae-theme="<%= fae_theme_mode %>">
  <head>
    <title><%= page_title %></title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <% if @option.favicon.present? && @option.favicon.asset.present? %>
      <link href="<%= @option.favicon.asset_url %>" rel="shortcut icon">
    <% end %>
    <%= csrf_meta_tags %>
    <%= inertia_ssr_head %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'fae' %>
  </head>

  <body class="<%= body_class %>" style="--fae-highlight: <%= fae_highlight %>;">
    <%= yield %>
  </body>
</html>
