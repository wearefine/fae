FROM ruby:3.3-bookworm

RUN apt-get update -y && apt-get install -y --no-install-recommends \
      build-essential \
      chromium \
      fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

ENV app /app
ENV BUNDLE_PATH /gems
ENV GEM_HOME /gems

COPY Gemfile* $app/

ENV PATH="$PATH:$BUNDLE_PATH/bin"

COPY . $app/
