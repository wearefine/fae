<%= render 'fae/shared/index_header', title: "#{@klass_humanized.pluralize}" %>

<main class="content">
  <%# Filtering, sorting and paging update this frame in place, with their state in the URL %>
  <%= fae_filter_frame 'people_results' do %>
    <%= fae_filter_form title: 'Search people' do %>
      <%= fae_filter_select :event, collection: Event.all, label: 'Event' %>
    <% end %>

    <table>
      <thead>
        <tr>
          <th data-sort="name">Name</th>
          <th class="-thumb">Image</th>
          <th class="-action-wide" data-sort="updated_at">Modified</th>
          <th class="-action-wide" data-sorter="false">On Stage</th>
          <th class="-action-wide" data-sorter="false">On Prod</th>
          <th class="-action" data-sorter="false"></th>
        </tr>
      </thead>
      <tbody>
        <% if @items.present? %>
          <% @items.each do |item| %>
            <tr id="<%= "#{@klass_singular}_#{item.id}" %>">
              <td><%= link_to item.name, edit_admin_person_path(item.id) %></td>
              <td><%= image_tag item.image.asset.thumb.url if item.image.present? && item.image.asset.present? %></td>
              <td><%= fae_date_format item.updated_at %></td>
              <td><%= fae_toggle item, :on_stage %></td>
              <td><%= fae_toggle item, :on_prod %></td>
              <td><%= fae_delete_button item %></td>
            </tr>
          <% end %>
        <% else %>
          <tr><td colspan="6">No items found</td></tr>
        <% end %>
      </tbody>
    </table>

    <%= paginate @items %>
  <% end %>
</main>
